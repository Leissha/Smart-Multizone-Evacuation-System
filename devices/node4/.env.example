# Node 4 serial connection
SERIAL_PORT=
SERIAL_BAUD_RATE=9600
SERIAL_TIMEOUT=0.25
POLL_INTERVAL=0.02
ACK_TIMEOUT=3.0

# Node 4 ThingsBoard MQTT connection
THINGSBOARD_ENABLED=true
THINGSBOARD_HOST=mqtt.thingsboard.cloud
THINGSBOARD_PORT=8883
THINGSBOARD_ACCESS_TOKEN=
THINGSBOARD_TLS=true
DEVICE_ID=node-4-command-center
