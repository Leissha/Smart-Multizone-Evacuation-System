# Node 2 serial connection (leave SERIAL_PORT blank to auto-detect, e.g. COM4 or /dev/ttyACM0)
SERIAL_PORT=
SERIAL_BAUD_RATE=9600
SERIAL_TIMEOUT=0.25
POLL_INTERVAL=0.02
ACK_TIMEOUT=3.0
# Seconds without an Arduino frame before the edge reports sensor_ok=false
STALE_AFTER=5.0

# Node 2 ThingsBoard MQTT connection
THINGSBOARD_ENABLED=true
THINGSBOARD_HOST=mqtt.thingsboard.cloud
THINGSBOARD_PORT=8883
THINGSBOARD_ACCESS_TOKEN=
THINGSBOARD_TLS=true
DEVICE_ID=node-2-exit-monitoring
