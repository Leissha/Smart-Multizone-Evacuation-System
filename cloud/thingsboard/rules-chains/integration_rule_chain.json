          "jsScript": "return ['DEFAULT'];",
          "tbelScript": "var fire = metadata.get(\"fire_active\");\r\nvar sound = metadata.get(\"node3_sound_level\");\r\nvar vibration = metadata.get(\"node3_vibration\");\r\n\r\nvar fireOn = fire == true || fire == \"true\";\r\nvar vibrationOn = vibration == true || vibration == \"true\";\r\n\r\nvar soundLevel = 0.0;\r\n\r\nif (sound != null) {\r\n    soundLevel = parseDouble(sound);\r\n}\r\n\r\nif (fireOn && soundLevel > 100 && vibrationOn) {\r\n    return \"ISOLATE\";\r\n}\r\n\r\nreturn \"NO_ACTION\";"
